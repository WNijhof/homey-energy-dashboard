{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.drpeppers.energydashboard",
  "version": "0.2.14",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Energy Dashboard",
    "nl": "Energie Dashboard"
  },
  "description": {
    "en": "A live energy dashboard for any screen in your home",
    "nl": "Een live energiedashboard voor elk scherm in huis"
  },
  "category": [
    "energy"
  ],
  "tags": {
    "en": [
      "energy",
      "dashboard",
      "solar",
      "p1",
      "boiler"
    ],
    "nl": [
      "energie",
      "dashboard",
      "zonnepanelen",
      "p1",
      "boiler"
    ]
  },
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation",
    "homey:app:com.gruijter.powerhour"
  ],
  "brandColor": "#20C07C",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DrPeppers",
    "email": "drpeppers@duck.com"
  },
  "homepage": "https://github.com/WNijhof/homey-energy-dashboard",
  "source": "https://github.com/WNijhof/homey-energy-dashboard",
  "support": "https://github.com/WNijhof/homey-energy-dashboard/issues",
  "bugs": {
    "url": "https://github.com/WNijhof/homey-energy-dashboard/issues"
  },
  "api": {
    "getSettingsInfo": {
      "method": "GET",
      "path": "/settings-info"
    },
    "getDiagnosisReport": {
      "method": "GET",
      "path": "/diagnosis-report"
    },
    "importNights": {
      "method": "POST",
      "path": "/night-import"
    },
    "clearNightImport": {
      "method": "POST",
      "path": "/night-import/clear"
    }
  },
  "widgets": {
    "energy-flow": {
      "name": {
        "en": "Energy flows",
        "nl": "Energiestromen"
      },
      "height": 260,
      "transparent": false,
      "settings": [
        {
          "id": "perZone",
          "type": "number",
          "title": {
            "en": "Devices per room",
            "nl": "Apparaten per ruimte"
          },
          "value": 3,
          "min": 0,
          "max": 8
        },
        {
          "id": "animate",
          "type": "checkbox",
          "title": {
            "en": "Moving flows",
            "nl": "Bewegende stromen"
          },
          "value": true
        }
      ],
      "api": {
        "getFlow": {
          "method": "GET",
          "path": "/flow"
        }
      },
      "id": "energy-flow"
    },
    "energy-now": {
      "name": {
        "en": "Energy now",
        "nl": "Energie nu"
      },
      "height": 220,
      "transparent": false,
      "settings": [
        {
          "id": "show",
          "type": "dropdown",
          "title": {
            "en": "Show",
            "nl": "Tonen"
          },
          "value": "now",
          "values": [
            {
              "id": "now",
              "title": {
                "en": "Power now (W)",
                "nl": "Vermogen nu (W)"
              }
            },
            {
              "id": "both",
              "title": {
                "en": "Power now and kWh today",
                "nl": "Vermogen nu en kWh vandaag"
              }
            },
            {
              "id": "today",
              "title": {
                "en": "kWh today",
                "nl": "kWh vandaag"
              }
            }
          ]
        },
        {
          "id": "animate",
          "type": "checkbox",
          "title": {
            "en": "Moving flows",
            "nl": "Bewegende stromen"
          },
          "value": true
        }
      ],
      "api": {
        "getNow": {
          "method": "GET",
          "path": "/now"
        }
      },
      "id": "energy-now"
    },
    "groups": {
      "name": {
        "en": "Circuits",
        "nl": "Groepen"
      },
      "height": 240,
      "transparent": false,
      "settings": [
        {
          "id": "perPhase",
          "type": "checkbox",
          "title": {
            "en": "Per phase, with Other",
            "nl": "Per fase, met Overig"
          },
          "value": true
        },
        {
          "id": "devices",
          "type": "checkbox",
          "title": {
            "en": "Devices that use the most",
            "nl": "Apparaten die het meest gebruiken"
          },
          "value": false
        }
      ],
      "api": {
        "getGroups": {
          "method": "GET",
          "path": "/groups"
        }
      },
      "id": "groups"
    }
  }
}