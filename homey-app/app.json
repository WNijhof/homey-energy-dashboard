{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.drpeppers.energydashboard",
  "version": "1.0.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Energy Dashboard",
    "nl": "Energie Dashboard"
  },
  "description": {
    "en": "A live energy dashboard for any screen in your home",
    "nl": "Een live energiedashboard voor elk scherm in huis"
  },
  "category": [
    "energy"
  ],
  "tags": {
    "en": [
      "energy",
      "dashboard",
      "solar",
      "p1",
      "boiler"
    ],
    "nl": [
      "energie",
      "dashboard",
      "zonnepanelen",
      "p1",
      "boiler"
    ]
  },
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "brandColor": "#20C07C",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DrPeppers",
    "email": "drpeppers@duck.com"
  },
  "homepage": "https://github.com/WNijhof/homey-energy-dashboard",
  "source": "https://github.com/WNijhof/homey-energy-dashboard",
  "support": "https://github.com/WNijhof/homey-energy-dashboard/issues",
  "bugs": {
    "url": "https://github.com/WNijhof/homey-energy-dashboard/issues"
  },
  "api": {
    "getSettingsInfo": {
      "method": "GET",
      "path": "/settings-info"
    }
  },
  "widgets": {
    "energy-flow": {
      "name": {
        "en": "Energy flows",
        "nl": "Energiestromen"
      },
      "height": 260,
      "transparent": false,
      "settings": [
        {
          "id": "perZone",
          "type": "number",
          "title": {
            "en": "Devices per room",
            "nl": "Apparaten per ruimte"
          },
          "value": 3,
          "min": 0,
          "max": 8
        },
        {
          "id": "animate",
          "type": "checkbox",
          "title": {
            "en": "Moving flows",
            "nl": "Bewegende stromen"
          },
          "value": true
        }
      ],
      "api": {
        "getFlow": {
          "method": "GET",
          "path": "/flow"
        }
      },
      "id": "energy-flow"
    }
  }
}